<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
    <TextView android:id="@+id/notification_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:textColor="@color/timer_widget_text" />
    <Chronometer android:id="@+id/notification_countdown" android:layout_width="match_parent" android:layout_height="58dp"
        android:gravity="center_vertical" android:textSize="42sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="42sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light"
        android:textColor="@color/timer_widget_text" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/notification_paused" android:layout_width="match_parent" android:layout_height="58dp"
        android:gravity="center_vertical" android:textSize="42sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="42sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light" android:visibility="gone"
        android:textColor="@color/timer_widget_text" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/timer_widget_muted" />
</LinearLayout>

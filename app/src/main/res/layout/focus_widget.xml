<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/timer_widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/timer_widget_muted" android:textSize="11sp" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/timer_widget_text" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light" android:maxLines="1" android:visibility="gone" />
    <TextView android:id="@+id/widget_idle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="25:00" android:textColor="@color/timer_widget_text" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans-serif-light"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/timer_widget_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <Button android:stateListAnimator="@null" android:elevation="0dp" android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="14dp" android:text="@string/start_focus" android:textAllCaps="false" android:textSize="12sp" android:padding="4dp"
        android:textColor="@color/timer_widget_on_button" android:background="@drawable/widget_action_background" android:backgroundTint="@null" />
    <Button android:stateListAnimator="@null" android:elevation="0dp" android:id="@+id/widget_secondary" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>

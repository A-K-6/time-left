<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/timer_widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/timer_widget_muted" android:textSize="12sp" android:fontFamily="sans-serif-medium"
        android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/timer_widget_text" android:textSize="38sp" android:fontFamily="sans-serif-light"
        android:letterSpacing="-0.04" android:visibility="gone" />
    <TextView android:id="@+id/widget_idle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="25:00" android:textColor="@color/timer_widget_text" android:textSize="38sp" android:fontFamily="sans-serif-light"
        android:letterSpacing="-0.04" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/timer_widget_muted" android:textSize="10sp" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="14dp">
        <Button android:stateListAnimator="@null" android:elevation="0dp" android:id="@+id/widget_primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="@string/start_focus" android:textAllCaps="false" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:padding="4dp"
            android:textColor="@color/timer_widget_on_button" android:background="@drawable/widget_action_background" android:backgroundTint="@null" />
        <Button android:stateListAnimator="@null" android:elevation="0dp" android:id="@+id/widget_secondary" android:layout_width="64dp" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:text="@string/start_break" android:textAllCaps="false" android:textSize="12sp"
            android:padding="4dp" android:textColor="@color/timer_widget_text" android:background="@drawable/widget_secondary_background" android:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
